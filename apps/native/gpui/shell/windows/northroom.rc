// The program's resources on Windows (build.rs fills in the icon's path and the version).
1 ICON "@ICON@"

1 VERSIONINFO
FILEVERSION @NUMBERS@
PRODUCTVERSION @NUMBERS@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Northroom"
      VALUE "FileDescription", "Northroom"
      VALUE "FileVersion", "@VERSION@"
      VALUE "InternalName", "Northroom"
      VALUE "LegalCopyright", "Copyright Northroom"
      VALUE "OriginalFilename", "Northroom.exe"
      VALUE "ProductName", "Northroom"
      VALUE "ProductVersion", "@VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
